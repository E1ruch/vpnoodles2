# Environment
NODE_ENV=development

# Server
PORT=3000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=
ADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_IDS=

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vpnoodles
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vpnoodles
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# Remnawave API
REMNAWAVE_API_URL=https://your-remnawave-panel.com
REMNAWAVE_API_KEY=your_remnawave_api_key_here
REMNAWAVE_TIMEOUT_MS=10000
REMNAWAVE_DEFAULT_SQUAD=your_squad_uuid_here

# Payments (optional)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_URL=
TELEGRAM_PROVIDER_TOKEN=

# App settings
TRIAL_DURATION_DAYS=14
TRIAL_DEVICE_LIMIT=2
SUPPORT_USERNAME=support_username
