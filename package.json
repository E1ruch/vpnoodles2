{
  "name": "vpnoodles2",
  "version": "1.0.0",
  "description": "Production-ready Telegram VPN bot with Remnawave integration",
  "main": "dist/app/bootstrap.js",
  "scripts": {
    "dev": "tsx watch src/app/bootstrap.ts",
    "build": "tsc",
    "build:panel": "npm run build --prefix admin-panel",
    "start": "node dist/app/bootstrap.js",
    "lint": "eslint src/ --ext .ts",
    "test": "jest --verbose",
    "migrate": "tsx src/infrastructure/db/migrate.ts",
    "migrate:safe": "tsx src/infrastructure/db/migrate-safe.ts",
    "seed": "tsx src/infrastructure/db/seed.ts"
  },
  "keywords": [
    "vpn",
    "telegram",
    "bot",
    "remnawave"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "telegraf": "^4.16.3",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.19.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
